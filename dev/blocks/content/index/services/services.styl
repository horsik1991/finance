.services
	margin-top -110px
	position relative
	z-index 3
	&__list
		display flex
		column-gap 30px
		@media(max-width 711px)
			flex-wrap wrap
			column-gap: 25px
			row-gap 20px
		@media(max-width 480px)
			column-gap: 15px
			row-gap 10px
	&__item
		display flex
		background-color #fff
		padding 40px
		flex 1 1 30%
		justify-content left
		row-gap:10px
		transition: linear 0.3s all
		flex-wrap: wrap
		@media(max-width 711px)
			flex 1 0 30%
		&:hover
			background-color $secondColor
			color: #fff
			svg
				color:#fff
		&--green
			background-color $secondColor
			color: #fff
			>.services__img
				svg
					color: #fff
			&:hover
				background-color #fff
				color $mainBlack
				svg
					color:$secondColor
	&__title
		flex-basis 100%
	&__img
		width 48px
		height 48px
		svg
			color: $secondColor