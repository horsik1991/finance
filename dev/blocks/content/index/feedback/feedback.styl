.feedback
	margin 40px 0
	&__container
		display flex
		justify-content space-between
		*
			color $mainBlack
	&__btn
		background-color $primeColor
		color #fff
		padding 15px 40px
		border-radius 5px
		font-size 14px
		font-weight bold
		line-height: 28px
	&__title
		font-size 24px
		font-weight bold
		line-height: 32px
		color $mainBlack
	&__text
		margin-top 10px
		font-size 14px
		line-height: 28px
		font-weight medium