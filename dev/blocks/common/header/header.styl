.header
	position absolute
	width 100%
	left 0
	top 0
	z-index 50
	&__container
		display flex
		min-height: 104px
		align-items center
		padding 0 15px
		box-sizing: content-box
		@media (max-width 479px)
			min-height: 70px
	&__link
		font-size 24px
		font-weight 800
		color $mainBlack
	&__menu
		margin-left 133px
		@media (max-width 992px)
			margin-left 80px
		@media (max-width 767px)
			margin-left 50px
		@media (max-width 479px)
			margin-left 20px
.menu-header
	padding 5px 0
	&__list
		display flex
		flex-wrap: wrap
	&__item
		line-height: (24/$fontSize*100% )
		color $secondText
		font-weight 600
		&:not(:last-child)
			margin 0 21px 0 0
		@media (max-width 479px)
			font-size 18px
	

		
	