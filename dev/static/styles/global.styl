// @import './instruments/1vars.styl'

[class*="__container"]
	max-width 1049px
	padding 0 15px
	margin 0 auto
._ibg
	img
		position absolute
		left 0
		top 0
		width 100%
		height 100%
		object-fit: cover

body 
	height 100%
	// Скролл заблокирован
	.lock & 
		overflow hidden
		touch-action none

// // Оболочка 
.wrapper 
	min-height 100%
	display flex
	flex-direction column
	overflow hidden
	font-family $mainFont
	box-sizing: border-box
	font-weight $font-weight
	font-size $fontSize
	// Прижимаем footer
.main 
	flex 1 1 auto
	// Фикс для слайдеров
	> * 
		min-width 0
	
